#
# ZUMAPRO -- Fully integrated kernel for Google Tensor G4 (zumapro) phones.
#
# Pixel 9 family: caiman, comet, komodo, tegu, tokay.
#
# This is a focused, statically linked kernel: every driver is compiled
# into the kernel image and no loadable kernel modules are built (only the
# device tree blobs are produced, via MODULES_OVERRIDE below).  It is the
# FreeBSD analogue of arch/arm64/configs/zumapro_defconfig, restricted to
# the subset that FreeBSD currently supports on this SoC.
#

cpu		ARM64
ident		ZUMAPRO

#
# Generic ARM64 base: scheduler, VM, networking, filesystems, debugger,
# and the standard device set (PCI, GPIO/pinctrl, I2C, SPI, UART, vt with
# vt_simplefb, USB, MMC, HID, crypto, clk/phy/regulator/syscon, evdev...).
#
include 	"std.arm64"
include 	"std.dev"

#
# Google Tensor (Samsung Exynos derived) SoC support: enables FDT, the
# exynos UART, and builds the dtb/exynos device trees.
#
include 	"std.exynos"

#
# Fully integrated kernel: do not build any loadable driver modules.
# Restrict the module build to just the device tree blobs so the boards'
# *.dtb files are still produced for the bootloader to load.
#
makeoptions	MODULES_OVERRIDE="dtb/exynos"

#
# Always build the U-Boot booti image (kernel.bin) alongside the ELF, so it
# is produced without needing WITH_KERNEL_BIN on the command line.  This is
# the flat kernel with the arm64 Linux image header prepended, suitable for
# the U-Boot "booti" command.
#
makeoptions	WITH_KERNEL_BIN=1

#
# Early console for bring-up.  EARLY_PRINTF=exynos routes printf(9) through a
# polled write to the debug UART before the real console is configured, so
# panics and hangs that happen before cninit() are still visible.  SOCDEV_PA
# is the physical base of that UART (serial_0 / USI8 at 0x10870000), mapped
# early to socdev_va.  Comment both out once the console is known good.
#
options 	SOCDEV_PA=0x10870000
options 	EARLY_PRINTF=exynos

#
# vt(4) clamps the framebuffer to VT_FB_MAX_HEIGHT (default 2400), which is
# shorter than these phone panels (komodo is 2992 tall).  Raise it so the
# full panel height is used; vt sizes its static console buffers to this.
#
options 	VT_FB_MAX_HEIGHT=3200

#
# Bring-up convenience.  Storage (UFS) is not supported on this SoC yet, so
# the practical root device is an embedded or loader-supplied memory disk.
# MD_ROOT is already enabled by std.arm64; FUSEFS rounds out the userspace
# filesystem options present in the Linux defconfig (FUSE/CUSE).
#
options 	FUSEFS			# FUSE userspace filesystems

#
# USB 3.0 device controller used by this SoC (CONFIG_USB_DWC3).  Harmless
# until the USB PHY and DWC3 nodes are described in the device tree.
#
device		dwc3			# Synopsys DesignWare USB3 controller

#
# One-shot MMIO initializer.  Applies the device-tree "linux,mmio-init-helper"
# register writes early in boot, before the console and framebuffer come up.
# On zumapro this sets the DECON display autorefresh bit so the bootloader
# framebuffer keeps scanning out with no gap.
#
options 	MMIO_INIT

#
# Watchdog timer (google,gs101-wdt).  Uses the PMU syscon for its reset
# gating and provides watchdog(9).
#
device		exynos_wdt

#
# Volume and power buttons via gpiokeys(4), on the ALIVE pin controller's
# wakeup-EINT GPIOs.  The Samsung CMU clock driver and the Exynos pin
# controller (with its GPIO interrupt support) are pulled in automatically
# by SOC_GOOGLE_ZUMAPRO; gpio, fdt_pinctrl and evdev come from std.dev.
#
device		gpiokeys

#
# Embedded DOOM ramdisk.  An ext2 root image (built by
# ../../../../doom-fb/build.sh with mke2fs) is linked into the kernel and
# mounted as the root filesystem; its /sbin/init runs DOOM on /dev/fb0 with
# the volume/power buttons.  ext2fs is used (not tarfs) because the embedded
# image appears as the md(4) character device /dev/md0, which ext2fs reads via
# the buffer cache -- tarfs only mounts a regular file.  MD_ROOT and TMPFS
# come from std.arm64; the image is read-only so init mounts a tmpfs for
# DOOM's writable state.  MD_ROOT_SIZE is in KiB and must exceed the image
# (rootfs.ext2 is 45 MiB).
#
options 	EXT2FS			# ext2/3/4 filesystem
options 	MD_ROOT_SIZE=49152
options 	MD_ROOT_FSTYPE=\"ext2fs\"
makeoptions	MFS_IMAGE=/home/trijal/Builds/doom-fb/rootfs.ext2

#
# Not yet supported on FreeBSD for this SoC, and therefore intentionally
# absent (present in the Linux defconfig): the USI serial bus, the S2MPG
# PMIC/regulators, the Exynos UFS host and PHY, the Exynos DRM/DECON display
# pipeline, the Mali (Panthor) GPU, the System MMU (IOMMU), and ACPM/SCMI
# power management.
#
